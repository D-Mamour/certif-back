SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=chantial
DB_USER=chantial
DB_PASSWORD=chantial
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:4200
HF_TOKEN=votre_token_huggingface
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Production
CSRF_TRUSTED_ORIGINS=https://votre-domaine.example
# DEBUG=False active automatiquement HTTPS, HSTS et cookies Secure.

# Rapports / notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Chantial <noreply@example.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèle vision Hugging Face optionnel (résultat = indice, jamais validation automatique)
HF_VISION_MODEL=

# OCR : chemin du binaire Tesseract (Mac Intel Homebrew)
TESSERACT_CMD=/usr/local/bin/tesseract
